# Copie este arquivo para .env e preencha a chave.
# Crie a chave em https://console.anthropic.com e defina um limite de gasto mensal lá.
ANTHROPIC_API_KEY=

# Opcional
# CLAUDE_MODEL=claude-sonnet-5-5
# PORT=3000
# Verificações permitidas por pessoa (IP) a cada 10 minutos
# RATE_LIMIT=15
# Origens extras autorizadas a chamar a API (separadas por vírgula)
# ALLOWED_ORIGINS=https://meusite.com.br
